{
    "name": "@hodfords/nestjs-testing",
    "version": "12.0.1",
    "description": "Provides some tools for implementing Unit test in Nestjs.",
    "homepage": "https://github.com/hodfords-solutions/nestjs-testing#readme",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-testing/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-testing.git"
    },
    "license": "UNLICENSED",
    "author": "",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc",
        "format": "prettier --write \"sample/**/*.ts\" \"lib/**/*.ts\"",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "prepare": "is-ci || husky",
        "release:patch": "git add CHANGELOG.md && npm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "start": "nest start -p tsconfig.sample.json",
        "start:debug": "nest start --debug --watch -p tsconfig.sample.json",
        "start:dev": "npm run prebuild && nest start --watch -p tsconfig.sample.json",
        "start:prod": "node dist/sample/main",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "version": "auto-changelog && git add CHANGELOG.md",
        "wz-command": "wz-command"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/testing": ">=12.0.0",
        "vitest": ">=4.0.0"
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "11.0.2",
        "@hodfords/nestjs-prettier-config": "11.0.1",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/schematics": "12.0.0",
        "@nestjs/testing": "12.0.1",
        "@swc/core": "^1.13.5",
        "@types/express": "5.0.0",
        "@types/node": "25.2.0",
        "@types/pg": "^8.11.11",
        "@types/supertest": "2.0.16",
        "auto-changelog": "2.5.0",
        "eslint": "9.20.0",
        "express": "4.21.2",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "15.4.3",
        "pg": "^8.13.1",
        "prettier": "3.5.0",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.0.1",
        "rxjs": "7.8.1",
        "source-map-support": "0.5.21",
        "supertest": "7.0.0",
        "ts-loader": "9.6.2",
        "typescript": "5.9.3",
        "unplugin-swc": "^1.5.7",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "@nestjs/schematics": {
            "typescript": "$typescript"
        }
    },
    "dependencies": {
        "es-toolkit": "1.51.0"
    }
}
